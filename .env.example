# ---- Model -------------------------------------------------------------------
# V1 model (see docs/ARCHITECTURE.md §Model selection). Supported families: qwen2, llama, mistral.
NEURALSCOPE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# DEMO mode (random-weight fixture model, clearly flagged in the UI):
# NEURALSCOPE_MODEL=demo/random-qwen2-tiny
# Tokenizer used by the demo fixture model
NEURALSCOPE_DEMO_TOKENIZER=Qwen/Qwen2.5-0.5B-Instruct
# auto | cpu | cuda | mps
NEURALSCOPE_DEVICE=auto
# float32 recommended for interpretability measurements
NEURALSCOPE_DTYPE=float32
# 0 = torch default
NEURALSCOPE_NUM_THREADS=0

# ---- Capture -----------------------------------------------------------------
# minimal  : tokens, residual stream (all depths), logits summaries
# standard : + attention probabilities, per-head outputs (default)
# full     : + MLP outputs (future: Q/K/V, MLP pre-activations, gates, gradients)
TRACE_LEVEL=standard
NEURALSCOPE_MAX_PROMPT_TOKENS=160
NEURALSCOPE_MAX_NEW_TOKENS=48

# ---- Storage -----------------------------------------------------------------
# SQLite metadata (neuralscope.db) + safetensors activation files live here
# NEURALSCOPE_DATA_DIR=./data

# ---- Servers -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
# NEURALSCOPE_API_URL=http://127.0.0.1:8000
